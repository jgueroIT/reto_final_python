pipeline {
    agent any

    environment {
        IMAGE_NAME = "jgueroit/reto_final_python"
        REGISTRY_CREDENTIALS = "docker-hub-creds" // Cambia según el ID en Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                sh 'pip install -r requirements.txt'
                sh 'pytest --cov=app --cov-report=term'
            }
        }

        stage('Linting') {
            steps {
                sh 'flake8 app tests'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("${IMAGE_NAME}:${env.BUILD_NUMBER}")
                }
            }
        }

        stage('Push Image to Docker Registry') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                    branch 'master'
                }
            }
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', REGISTRY_CREDENTIALS) {
                        dockerImage.push("latest")
                        dockerImage.push("${env.BUILD_NUMBER}")
                    }
                }
            }
        }
    }
    

    post {
        always {
            junit '**/test-results.xml' // opcional
            cleanWs()
        }
    }
}
